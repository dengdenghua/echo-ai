{
  "schema": "echo.runtime-security-contract.v1",
  "contractId": "echo-runtime-safety",
  "version": "1.1.0",
  "profiles": {
    "echo-ai-runtime": {
      "product": "ai",
      "peerCredentialIssuance": "not-implemented",
      "extensions": [
        "receipt-telemetry"
      ],
      "note": "The standalone runtime denies shared-token peer calls by default. Tests set per-device mode in memory; this is not a device credential issuance or pairing implementation."
    },
    "echo-os": {
      "product": "os",
      "peerCredentialIssuance": "appliance-managed",
      "extensions": [
        "appliance-device-auth"
      ],
      "note": "The appliance production wrapper installs its per-device hello authentication. This contract exercises the runtime dispatch boundary with in-memory devices, not real enrollment."
    }
  },
  "testFiles": [
    "tests/test_runtime_diagnostics_auth.py",
    "tests/test_logging_redaction_fields.py",
    "tests/test_peer_execution_boundary.py",
    "tests/test_image_generation_command.py",
    "tests/test_sandbox_platform_contract.py"
  ],
  "cases": [
    {
