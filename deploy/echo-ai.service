[Unit]
Description=Echo-Agent · biomimetic self-evolving agent OS
Documentation=https://github.com/dengdenghua/echo-ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=echo
Group=echo
WorkingDirectory=/var/lib/echo

# Implementation note.
EnvironmentFile=/etc/echo/echo.env
Environment=ECHO_DATA_DIR=/var/lib/echo

# Implementation note.
ExecStart=/opt/echo-ai/.venv/bin/echo-ai serve \
    --config /etc/echo/config.yaml \
    --host 0.0.0.0 \
    --port 8000

Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=5

# Implementation note.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/echo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
CapabilityBoundingSet=

# Implementation note.
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target
