# Copy to a private .env file and pass it with:
#   docker compose --env-file .env -f deploy/cloud-edge-compose.yml up -d --build
# Never commit the populated file.

# Three independent secrets. Generate each separately.
# These deliberately-short placeholders make the service fail closed if the
# operator forgets to replace them.
ECHO_CLOUD_EDGE_TOKEN_SECRET=<CHANGE_ME>
ECHO_CLOUD_EDGE_ADMIN_KEY=<CHANGE_ME>
ECHO_CLOUD_REGISTRATION_CODE=<CHANGE_ME>
ECHO_CLOUD_SHARE_RELAY_KEY=<CHANGE_ME>

ECHO_CLOUD_EDGE_OWNER_ID=admin
ECHO_CLOUD_EDGE_TENANT_ID=default

# Fixed HTTPS origin returned to desktop clients. No trailing slash.
ECHO_PUBLIC_SHARE_BASE_URL=https://share.echo-age.com

# 30 days, 50 live shares per owner, 1 MiB per snapshot, 512 MiB total.
ECHO_CLOUD_EDGE_SHARE_TTL_SECONDS=2592000
ECHO_CLOUD_EDGE_SHARE_MAX_PER_OWNER=50
ECHO_CLOUD_EDGE_SHARE_MAX_SNAPSHOT_BYTES=1048576
ECHO_CLOUD_EDGE_SHARE_MAX_TOTAL_BYTES=536870912

# Keep the relay private behind the same-host reverse proxy.
ECHO_CLOUD_EDGE_BIND_IP=127.0.0.1
ECHO_CLOUD_EDGE_PORT=8090
